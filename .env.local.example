# Copy to .env.local for local dev, and set the same keys in Vercel project
# settings (Project → Settings → Environment Variables) before deploying.

# Klaviyo private API key, needs profile/subscription write scope.
# Create at: Klaviyo → Settings → API Keys → Create Private API Key
KLAVIYO_PRIVATE_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Klaviyo list new "Únete a la lista" signups should join.
# Find at: Klaviyo → Lists & Segments → (your list) → List ID in the URL/settings.
KLAVIYO_LIST_ID=XXXXXX
